# Database configuration
# Defaults to local file-backed SQLite with C-level authorizer isolation when PostgreSQL is not running.
# For Docker PostgreSQL 16:
# APP_DATABASE_URL=postgresql+asyncpg://metrictruth_app:metrictruth_app_pw@localhost:5432/metrictruth
# READONLY_DATABASE_URL=postgresql+asyncpg://metrictruth_reader:metrictruth_reader_pw@localhost:5432/metrictruth
APP_DATABASE_URL=sqlite+aiosqlite:///./data/metrictruth.db
READONLY_DATABASE_URL=sqlite+aiosqlite:///./data/metrictruth.db

# Optional Redis cache (falls back to in-memory TTL cache when unreachable)
REDIS_URL=redis://localhost:6379/0

# OpenRouter configuration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_FAST=google/gemini-2.5-flash
MODEL_SYNTHESIS=google/gemini-2.5-flash
LLM_MODE=auto

GROQ_API_KEY=

# Security & Role Tokens (for local/demo RBAC testing)
VIEWER_API_KEY=mt-viewer-key-2026
ANALYST_API_KEY=mt-analyst-key-2026
ADMIN_API_KEY=mt-admin-key-2026

# Reporting & Telemetry
REPORTING_TIMEZONE=America/New_York
REFERENCE_TODAY=2026-11-30
OTEL_CAPTURE_CONTENT=false
